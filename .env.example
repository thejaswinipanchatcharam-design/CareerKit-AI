# Application Configuration
SECRET_KEY=change-this-to-a-random-hex-string-for-production
FLASK_ENV=development
FLASK_DEBUG=1

# AI Provider Configuration
# Choose between: 'gemini' (recommended) or 'groq'
AI_PROVIDER=gemini

# Google Gemini API Settings (Get key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Settings (Optional alternative; get key from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Document Upload & Storage Settings
MAX_CONTENT_LENGTH=10485760
